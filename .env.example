# Graph Viewer configuration.
#
# Production Railway deployments usually leave this file unused. The canonical
# hosted entrypoint is AutoMem API `/viewer/#token=...`, which forwards the
# browser to the standalone viewer with `?server=<automem-origin>`.

# API target for local dev proxy
# Do not set this on the production Railway viewer service; production browser
# traffic uses the `server=` URL parameter supplied by AutoMem `/viewer`.
# Production (default when unset):
# VITE_API_TARGET=https://automem.up.railway.app
# Local Docker (run `docker compose up` in automem repo first):
VITE_API_TARGET=http://localhost:8001

# Build base path (optional, default: /)
# Keep `/` for the standalone viewer service. Use `/viewer/` only if the built
# assets are actually served from the AutoMem API origin under that subpath.
# VITE_BASE_PATH=/

# Hand gesture controls are now always available via the UI button.
# Do not set VITE_ENABLE_HAND_CONTROLS; that variable is obsolete.

# iPhone LiDAR hand-tracking bridge (local dev only).
# The bridge (scripts/hand-tracking-server.js) autostarts with `npm run dev:all`
# and forwards iPhone frames to the browser on :8766/ws. By default the browser
# derives the URL from the page origin (ws://<page-host>:8766/ws on http), so
# opening the dev server from another device on the same WiFi just works.
# Override only for a non-standard host/port. There is no relay in production.
# VITE_HAND_BRIDGE_URL=ws://192.168.1.50:8766/ws
